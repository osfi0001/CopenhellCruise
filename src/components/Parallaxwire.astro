---
<section class="parallaxgrafik fullwidthsection">	
	<div class="mt-8  relative h-48 overflow-hidden">
		<img 
			src="barbedwirealt.svg" 
			alt="" 
			class="parallaxgrafik1 absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 rotate-[-5deg] z-10"
			
		/>
		<img 
			src="barbedwirealt.svg" 
			alt="" 
			class="parallaxgrafik2 absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 rotate-[5deg] scale-x-[-1] z-20"
		/>
	</div>
</section>

<script>
import { animate, stagger, inView, scroll } from "motion";

    	scroll(animate(".parallaxgrafik1", { x: [-400, 600] }), {
		target: document.querySelector(".parallaxgrafik"), offset: ["start end", "end start"]
	});
	scroll(animate(".parallaxgrafik2", { x:[-400, -600]}), {
		target: document.querySelector(".parallaxgrafik"), offset: ["start end", "end start"]
	});
</script>